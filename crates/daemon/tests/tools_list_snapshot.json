    {
      "description": "Clear embedding cache and/or search cache. namespace controls which: embeddings (default), searches, or all. For embeddings, optional model/before/keep_recent filter the rows cleared.",
      "inputSchema": {
        "$defs": {
          "Namespace": {
            "enum": [
              "embeddings",
              "searches",
              "all"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "before": {
            "default": null,
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "keep_recent": {
            "default": null,
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "model": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "namespace": {
            "$ref": "#/$defs/Namespace",
            "default": "embeddings"
          }
        },
        "title": "ClearParams",
        "type": "object"
      },
      "name": "cache.clear"
    },
