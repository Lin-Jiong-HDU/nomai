    {
      "description": "Fulltext search over block text via SQLite FTS5. Returns entries ranked by relevance. Score is relative relevance (not a boolean hit marker): higher means stronger match; near-zero means weak match. Each call is cached per (query, limit, block_type).",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "block_type": {
            "default": null,
            "description": "Optional block-type filter (e.g. `\"claim\"`, `\"note\"`). When supplied,\nrestricts matches to blocks of that type.",
            "type": [
              "string",
              "null"
            ]
          },
          "limit": {
            "default": 10,
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "query": {
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "title": "FulltextParams",
        "type": "object"
      },
      "name": "search.fulltext"
    },
    {
