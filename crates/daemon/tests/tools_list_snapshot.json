            "type": [
              "string",
              "null"
            ]
          },
          "limit": {
            "default": 10,
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "query": {
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "title": "SemanticParams",
        "type": "object"
      },
      "name": "search.semantic"
    },
