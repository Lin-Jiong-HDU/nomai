    },
    {
      "description": "List events matching filters, ordered by ULID (time-ordered). since is exclusive (returns id > since). Use for incremental sync: client tracks last_seen_id and pulls via since=last_seen_id. Default limit 100, order asc. Returns {items, has_more, total}.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "limit": {
            "default": 100,
            "minimum": 0,
            "type": "integer"
          },
          "order": {
            "default": "asc",
            "enum": [
              "asc",
              "desc"
            ],
            "type": "string"
          },
          "since": {
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "target_id": {
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "target_type": {
            "description": "\"entry\" or \"link\"",
            "type": "string"
          },
          "type": {
            "description": "event type filter, e.g. \"entry.created\"",
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "events.list"
    },
    {
      "description": "Delete events with id < before (exclusive). Optional type filter (e.g. \"entry.created\"). For retention/cleanup. Returns {deleted: N}.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "before": {
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "before"
        ],
        "type": "object"
      },
      "name": "events.purge"
    },
    {
      "description": "Wipe every derived table and re-index every entry from the filesystem. Use to recover from index corruption; heavier than index.sync.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "name": "index.rebuild"
    },
    {
      "description": "Reconcile the SQLite index with the filesystem source-of-truth. Walks every entry's .nomai file, diffing mtime; adds/updates/removes rows as needed. Returns per-bucket counts.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "name": "index.sync"
    },
    {
      "description": "Read-only drift report between the filesystem and the SQLite index. Same scan as index.sync but never mutates; use to preview drift before deciding to sync or rebuild.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "name": "index.verify"
    },
